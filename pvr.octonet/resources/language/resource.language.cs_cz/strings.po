msgctxt "Addon Summary"
msgid "Kodi PVR Addon for Digital Devices Octopus NET Streams"
msgstr "Doplněk PVR pro streamy Digital Devices Octopus NET v Kodi"

msgctxt "#30000"
msgid "Octonet Server Address"
msgstr "Adresa serveru Octonet"

msgctxt "#30001"
msgid "Could not load chanellist"
msgstr "Nelze načíst seznam kanálů"

msgctxt "#30002"
msgid "Timeshift"
msgstr "Časový posun"

msgctxt "#30003"
msgid "Enable timeshift"
msgstr "Povolit časový posun"

msgctxt "#30004"
msgid "- Modify inputstream.ffmpegdirect settings..."
msgstr "- Upravit nastavení inputstream.ffmpegdirect..."

msgctxt "#30005"
msgid "Inputstream settings"
msgstr "Nastavení Inputstream"

#empty strings from id 30006 to 30599
msgctxt "#30600"
msgid "The IP/address of the octonet server. Note that in case of an address, the protocol (http://) has to be omitted."
msgstr "IP adresa nebo adresa serveru Octonet. Pokud zadáváte adresu, protokol (http://) je nutné vynechat."

msgctxt "#30601"
msgid "General settings required by the add-on."
msgstr "Obecná nastavení vyžadovaná doplňkem."

msgctxt "#30602"
msgid "Timeshift settings for pausing/rewinding and fast-forwarding live streams."
msgstr "Nastavení časového posunu pro pozastavení, přetáčení zpět a rychlé přetáčení živých streamů."

msgctxt "#30603"
msgid "Enable the timeshift feature."
msgstr "Povoluje funkci časového posunu."

msgctxt "#30604"
msgid "Open settings dialog for inputstream.ffmpegdirect for modification of timeshift and other settings."
msgstr "Otevře dialog nastavení doplňku inputstream.ffmpegdirect pro úpravu časového posunu a dalších nastavení."
