msgctxt "Addon Summary"
msgid "Kodi PVR Addon for Digital Devices Octopus NET Streams"
msgstr "Kodi PVR-tillägg för Digital Devices Octopus NET-strömmar"

msgctxt "#30000"
msgid "Octonet Server Address"
msgstr "Serveradress för Octonet"

msgctxt "#30001"
msgid "Could not load chanellist"
msgstr "Kunde inte läsa in kanallista"

msgctxt "#30002"
msgid "Timeshift"
msgstr "Tidsförskjutning"

msgctxt "#30003"
msgid "Enable timeshift"
msgstr "Aktivera tidsskifte"

msgctxt "#30004"
msgid "- Modify inputstream.ffmpegdirect settings..."
msgstr "- Ändra inställningar för inputstream.ffmpegdirect..."

msgctxt "#30005"
msgid "Inputstream settings"
msgstr "Inställningar för Inputstream"

#empty strings from id 30006 to 30599
msgctxt "#30600"
msgid "The IP/address of the octonet server. Note that in case of an address, the protocol (http://) has to be omitted."
msgstr "IP-adressen för octonet-servern. Observera att i fallet med en adress måste protokollet (http://) utelämnas."

msgctxt "#30601"
msgid "General settings required by the add-on."
msgstr "Allmänna inställningar som krävs av tillägget."

msgctxt "#30602"
msgid "Timeshift settings for pausing/rewinding and fast-forwarding live streams."
msgstr "Inställningar för tidsförskjutning vid pausning/spolning bakåt och snabbspolning framåt av direktströmmar."

msgctxt "#30603"
msgid "Enable the timeshift feature."
msgstr "Aktivera tidsförskjutningsfunktionen."

msgctxt "#30604"
msgid "Open settings dialog for inputstream.ffmpegdirect for modification of timeshift and other settings."
msgstr "Öppna inställningsdialogen för inputstream.ffmpegdirect för att ändra tidsförskjutning och andra inställningar."
