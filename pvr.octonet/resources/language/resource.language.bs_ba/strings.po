msgctxt "Addon Summary"
msgid "Kodi PVR Addon for Digital Devices Octopus NET Streams"
msgstr "Kodi PVR dodatak za digitalne uređaje Octopus NET streamovi"

msgctxt "#30000"
msgid "Octonet Server Address"
msgstr "Adresa Octonet servera"

msgctxt "#30001"
msgid "Could not load chanellist"
msgstr "Nije moguće učitati listu kanala"

msgctxt "#30002"
msgid "Timeshift"
msgstr "Vremenski pomak"

msgctxt "#30003"
msgid "Enable timeshift"
msgstr "Omogući vremenski pomak"

msgctxt "#30004"
msgid "- Modify inputstream.ffmpegdirect settings..."
msgstr "- Izmijenite postavke inputstream.ffmpegdirect..."

msgctxt "#30005"
msgid "Inputstream settings"
msgstr "Postavke ulaznog toka"

#empty strings from id 30006 to 30599
msgctxt "#30600"
msgid "The IP/address of the octonet server. Note that in case of an address, the protocol (http://) has to be omitted."
msgstr "IP/adresa Octonet servera. Imajte na umu da u slučaju adrese, protokol (http://) mora biti izostavljen."

msgctxt "#30601"
msgid "General settings required by the add-on."
msgstr "Opšta podešavanja koja zahtijeva dodatak."

msgctxt "#30602"
msgid "Timeshift settings for pausing/rewinding and fast-forwarding live streams."
msgstr "Postavke vremenskog pomaka za pauziranje/premotavanje unazad i premotavanje unaprijed uživo."

msgctxt "#30603"
msgid "Enable the timeshift feature."
msgstr "Omogućite funkciju vremenskog pomaka."

msgctxt "#30604"
msgid "Open settings dialog for inputstream.ffmpegdirect for modification of timeshift and other settings."
msgstr "Otvorite dijalog postavki za inputstream.ffmpegdirect za modifikaciju vremenskog pomaka i drugih postavki."
