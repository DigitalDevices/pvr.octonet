msgctxt "Addon Summary"
msgid "Kodi PVR Addon for Digital Devices Octopus NET Streams"
msgstr "Extension enregistreur vidéo (PVR) pour Digital Devices Octopus NET Streams"

msgctxt "#30000"
msgid "Octonet Server Address"
msgstr "Adresse du serveur Octonet"

msgctxt "#30001"
msgid "Could not load chanellist"
msgstr "Impossible de charger la liste des chaînes"

msgctxt "#30002"
msgid "Timeshift"
msgstr "Contrôle du direct (Timeshift)"

msgctxt "#30003"
msgid "Enable timeshift"
msgstr "Activer le contrôle du direct"

msgctxt "#30004"
msgid "- Modify inputstream.ffmpegdirect settings..."
msgstr "- Modifier les paramètres de inputstream.ffmpegdirect..."

msgctxt "#30005"
msgid "Inputstream settings"
msgstr "Paramètres Inputstream"

#empty strings from id 30006 to 30599
msgctxt "#30600"
msgid "The IP/address of the octonet server. Note that in case of an address, the protocol (http://) has to be omitted."
msgstr "IP/adresse du serveur Octonet. Dans le cas d'une adresse, le protocole (http://) doit être omis."

msgctxt "#30601"
msgid "General settings required by the add-on."
msgstr "Paramètres généraux requis par l'extension."

msgctxt "#30602"
msgid "Timeshift settings for pausing/rewinding and fast-forwarding live streams."
msgstr "Paramètres de contrôle du direct pour mettre en pause/rembobiner et avancer rapidement les flux en direct."

msgctxt "#30603"
msgid "Enable the timeshift feature."
msgstr "Activer la fonction de contrôle du direct."

msgctxt "#30604"
msgid "Open settings dialog for inputstream.ffmpegdirect for modification of timeshift and other settings."
msgstr "Ouvrir la boîte de dialogue des paramètres pour inputstream.ffmpegdirect pour modifier le contrôle du direct et d'autres paramètres."
